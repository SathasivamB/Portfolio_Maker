{
  "name": "portfolio-maker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "build:server": "node server/build.js",
    "build:all": "npm run build && npm run build:server",
    "db:init": "node server/db-init.js",
    "db:migrate": "node server/db-init.js",
    "db:inspect": "node scripts/inspect-db.js",
    "preview": "vite preview",
    "test": "node --test tests/unit/**/*.test.js tests/functional/**/*.test.js tests/e2e/**/*.test.js",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:functional": "node --test tests/functional/**/*.test.js",
    "test:e2e": "node --test tests/e2e/**/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.64.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.14"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node"
  }
}
